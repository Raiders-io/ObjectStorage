# Node
TZ=UTC
API_PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
AUTH_SERVICE_URL=http://auth-service:3333/
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Object Storage
OBJECT_STORAGE_PORT=3900
GARAGE_DEFAULT_SECRET_KEY=
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_BUCKET=default-bucket
# syntax is 'garage=${LOG}', with LOG=error, warn, info (default), debug and trace.
GARAGE_RUST_LOG=info
GARAGE_SERVICE_NAME=garage
GARAGE_ADMIN_TOKEN=
GARAGE_RPC_SECRET=
GARAGE_METRICS_TOKEN=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=garage
POSTGRES_SERVICE_NAME=postgresql
POSTGRES_HOST=${POSTGRES_SERVICE_NAME}
POSTGRES_PORT=5432

# API
DRIVE_DISK=s3
# FS_STORAGE_PATH=storage   (only used with DRIVE_DISK=fs)
AWS_ACCESS_KEY_ID=${GARAGE_DEFAULT_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${GARAGE_DEFAULT_SECRET_KEY}
AWS_REGION=garage # This should match the s3_region in garage.toml
S3_BUCKET=${GARAGE_DEFAULT_BUCKET}
S3_ENDPOINT=http://${GARAGE_SERVICE_NAME}:${OBJECT_STORAGE_PORT}

# Message Broker
REDIS_URL=redis://redis:6379
CONSUMER_ID=

# Docker Specific
IMAGE_NAME=object-api
IMAGE_TAG=latest

# Legacy (AdonisJS only, ignored by the NestJS version, safe to delete):
# APP_KEY, APP_URL, SESSION_DRIVER
