# Node
TZ=UTC
API_PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${API_PORT}
AUTH_SERVICE_URL=http://auth-service:3333/

# Auth Service
AUTH_SERVICE_URL=http://auth-service:3333

# Session & Drive
SESSION_DRIVER=cookie
DRIVE_DISK=s3

# Docker Specific
IMAGE_NAME=object-api
IMAGE_TAG=latest

AWS_REGION=us-east-1
S3_BUCKET=object-storage
S3_ENDPOINT=http://garage:3900

# PostgreSQL Configuration
POSTGRES_SERVICE_NAME=object-db
POSTGRES_PORT=5432
POSTGRES_DB=objectstorage
# These can be loaded from Vault:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Vault Configuration
VAULT_ADDR=http://vault:8200
VAULT_KEY=root
VAULT_PATH=secret/objectstorage

# Garage Configuration (if not using Vault)
GARAGE_DEFAULT_ACCESS_KEY=access_key
GARAGE_DEFAULT_SECRET_KEY=secret_key
GARAGE_DEFAULT_BUCKET=object-storage
# Object Storage
OBJECT_STORAGE_PORT=3900
GARAGE_DEFAULT_SECRET_KEY=
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_BUCKET=default-bucket
# syntax is 'garage=${LOG}', with LOG=error, warn, info (default), debug and trace.
GARAGE_RUST_LOG=info
GARAGE_ADMIN_TOKEN=admin_token
GARAGE_RPC_SECRET=rpc_secret
GARAGE_METRICS_TOKEN=metrics_token

# Message Broker
REDIS_URL=redis://redis:6379
CONSUMER_ID=
